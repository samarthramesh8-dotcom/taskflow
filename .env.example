# Server Configuration
NODE_ENV=production
PORT=4000

# JWT Configuration
JWT_SECRET=your-very-secure-random-secret-key-change-me

# CORS Configuration (comma-separated list)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database (SQLite - no config needed, but can add backup path)
DB_BACKUP_PATH=/var/backups/taskmaster
