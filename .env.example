# Server Configuration
NODE_ENV=production
PORT=4000

# JWT Configuration (REQUIRED - generate secure random string)
JWT_SECRET=your-very-secure-random-secret-key-change-me

# CORS Configuration (REQUIRED - comma-separated Vercel URLs)
ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app-git-main.vercel.app,https://your-app-production.vercel.app

# Database (SQLite - no config needed)
DB_BACKUP_PATH=/var/data/taskmaster
